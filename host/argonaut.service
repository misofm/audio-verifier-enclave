[Unit]
Description=argonaut: TCP 127.0.0.1:3000 to the enclave's vsock 16:3000
After=network-online.target audio-verifier-enclave.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/argonaut host 16 --inbound 127.0.0.1:3000=3000 --max-connections 256 --log-connections=false
Restart=always
RestartSec=2
DynamicUser=yes

[Install]
WantedBy=multi-user.target
